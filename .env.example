# ---------------------------------------------------------------------------
# Savewise — environment configuration
#
# Copy to `.env` in this directory and fill in the blanks:
#
#   cp .env.example .env
#
# One file serves the whole monorepo: the API loads it via dotenv and Vite
# loads it through `envDir`. `.env` is gitignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
PORT=5000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# Local Docker:  mongodb://127.0.0.1:27017/savewise   (`npm run db:up`)
# Atlas:         mongodb+srv://<user>:<password>@<cluster>/savewise?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/savewise

# --- Authentication --------------------------------------------------------
# Two independent secrets: a leaked access secret must not also mint refresh
# tokens. Generate each with:  openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

# Keep the access token short-lived; the refresh token silently renews it.
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Signs the auth cookies so tampering is detectable.
COOKIE_SECRET=

# Set to `true` when the API is served over HTTPS behind a proxy in production.
COOKIE_SECURE=false
# Leave blank for host-only cookies. Set to e.g. `.savewise.app` to share a
# cookie between `app.savewise.app` and `api.savewise.app`.
COOKIE_DOMAIN=

# --- CORS ------------------------------------------------------------------
# Comma-separated list of browser origins allowed to send credentialed requests.
CLIENT_URL=http://localhost:5173

# --- Rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Seeding ---------------------------------------------------------------
# Credentials for the demo account created by `npm run seed`.
# DEVELOPMENT ONLY — never reuse these anywhere real.
SEED_DEMO_EMAIL=demo@savewise.local
SEED_DEMO_PASSWORD=DemoPassword123!

# --- Web client ------------------------------------------------------------
# Read by Vite at build time. Must be reachable from the browser.
VITE_API_URL=http://localhost:5000/api
VITE_APP_URL=http://localhost:5173
